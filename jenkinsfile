pipeline {

    agent any

    stages {

        stage('Checkout') {

            steps {

                checkout scm

            }

        }

        stage('Docker Build') {

            steps {

                sh '''
                    cd backend
                    docker build -t employee-backend:${BUILD_NUMBER} .
                '''

            }

        }

        stage('Docker Test') {

            steps {

                sh '''
                    docker images
                '''

            }

        }

    }
}